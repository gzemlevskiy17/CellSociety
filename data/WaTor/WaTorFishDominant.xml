<?xml version="1.0" encoding="UTF-8"?>
<simulation>
    <type>WaTor</type>
    <title>Fish Dominant</title>
    <author>Michael</author>
    <description>Many fish, few sharks. Fish should overwhelm initially before sharks catch up.</description>
    <grid>
        <rows>20</rows>
        <columns>20</columns>
        <stateDistribution type="proportion">
            <state id="0" proportion="0.30"/>
            <state id="1" proportion="0.60"/>
            <state id="2" proportion="0.10"/>
        </stateDistribution>
    </grid>
    <parameters>
        <speed>5</speed>
        <pyRepro>2</pyRepro>
        <pdrEner>3</pdrEner>
        <pdrRepro>10</pdrRepro>
        <pdrEatsFor>2</pdrEatsFor>
        <states>
            <state id="0" name="EMPTY" color="#1A5276"/>
            <state id="1" name="FISH" color="#2ECC71"/>
            <state id="2" name="SHARK" color="#E74C3C"/>
        </states>
    </parameters>
</simulation>
