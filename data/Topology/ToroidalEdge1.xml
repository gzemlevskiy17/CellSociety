<?xml version="1.0" encoding="UTF-8"?>
<simulation>
    <type>GameOfLife</type>
    <title>Toroidal Edge - Glider Wrapping</title>
    <author>Michael Li</author>
    <description>GameOfLife with toroidal edges. The glider pattern will wrap around grid boundaries.</description>
    <grid>
        <rows>8</rows>
        <columns>8</columns>
        <edge>Toroidal</edge>
        <cells>
            <row>0 0 0 0 0 0 0 0</row>
            <row>0 0 1 0 0 0 0 0</row>
            <row>0 0 0 1 0 0 0 0</row>
            <row>0 1 1 1 0 0 0 0</row>
            <row>0 0 0 0 0 0 0 0</row>
            <row>0 0 0 0 0 0 0 0</row>
            <row>0 0 0 0 0 0 0 0</row>
            <row>0 0 0 0 0 0 0 0</row>
        </cells>
    </grid>
    <parameters>
        <speed>3</speed>
        <states>
            <state id="0" name="DEAD" color="#FFFFFF"/>
            <state id="1" name="ALIVE" color="#2ECC71"/>
        </states>
    </parameters>
</simulation>
