<?xml version="1.0" encoding="UTF-8"?>
<simulation>
  <author>Test Configuration</author>
  <description>Fire starts in corner and burns a small cluster. Fire travels to bottom right corner.
    All trees burn in 7 steps.
  </description>
  <grid>
    <cells>
      <row>2 1 1 0 0 0 0 0</row>
      <row>1 1 1 0 0 0 0 0</row>
      <row>1 1 1 1 1 0 0 0</row>
      <row>0 0 0 0 0 1 0 0</row>
      <row>0 0 0 0 0 0 1 1</row>
      <row>0 0 0 0 0 0 1 1</row>
    </cells>
    <columns>8</columns>
    <rows>6</rows>
  </grid>
  <parameters>
    <fillProbability>0.0</fillProbability>
    <ignitionProbability>0.0</ignitionProbability>
    <speed>4</speed>
    <states>
      <state color="#FFFFFF" id="0" name="EMPTY"/>
      <state color="#27AE60" id="1" name="TREE"/>
      <state color="#C0392B" id="2" name="BURNING"/>
    </states>
  </parameters>
  <title>Forest Fire - Corner Burn</title>
  <type>ForestFire</type>
</simulation>

