<?xml version="1.0" encoding="UTF-8"?>
<simulation>
    <type>Segregation</type>
    <title>Segregation Edge Small</title>
    <author>Thomas Schelling</author>
    <description>5x5 grid with agents on edges. Low threshold leads to quick satisfaction.</description>
    <grid>
        <rows>5</rows>
        <columns>5</columns>
        <cells>
            <row>1 2 1 2 1</row>
            <row>2 0 0 0 2</row>
            <row>1 0 0 0 1</row>
            <row>2 0 0 0 2</row>
            <row>1 2 1 2 1</row>
        </cells>
    </grid>
    <parameters>
        <probCatch>0.3</probCatch>
        <states>
            <state id="0" color="#FFFFFF"/>
            <state id="1" color="#3498DB"/>
            <state id="2" color="#E74C3C"/>
        </states>
    </parameters>
</simulation>
