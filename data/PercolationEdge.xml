<?xml version="1.0" encoding="UTF-8"?>
<simulation>
    <type>Percolation</type>
    <title>Edge Percolation</title>
    <author>Michael</author>
    <description>Water starts from the left edge and percolates rightward. Active percolated cells on the edge.</description>
    <grid>
        <rows>10</rows>
        <columns>10</columns>
        <cells>
            <row>2 0 0 1 0 0 1 0 0 0</row>
            <row>2 0 1 0 0 1 0 0 1 0</row>
            <row>2 1 0 0 1 0 0 0 0 0</row>
            <row>2 0 0 1 0 0 0 1 0 0</row>
            <row>2 0 1 0 0 0 1 0 0 0</row>
            <row>2 0 0 0 1 0 0 0 0 1</row>
            <row>2 1 0 0 0 0 1 0 1 0</row>
            <row>2 0 0 1 0 1 0 0 0 0</row>
            <row>2 0 1 0 0 0 0 1 0 0</row>
            <row>2 0 0 0 1 0 0 0 0 0</row>
        </cells>
    </grid>
    <parameters>
        <speed>3</speed>
        <states>
            <state id="0" name="OPEN" color="#FFFFFF"/>
            <state id="1" name="BLOCKED" color="#000000"/>
            <state id="2" name="PERCOLATED" color="#3498DB"/>
        </states>
    </parameters>
</simulation>
