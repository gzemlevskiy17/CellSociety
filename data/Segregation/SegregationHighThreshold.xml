<?xml version="1.0" encoding="UTF-8"?>
<simulation>
    <type>Segregation</type>
    <title>Segregation High Threshold</title>
    <author>Thomas Schelling</author>
    <description>8x8 mixed grid with 70% threshold. High intolerance causes large-scale segregation.</description>
    <grid>
        <rows>8</rows>
        <columns>8</columns>
        <cells>
            <row>1 2 1 2 0 1 2 1</row>
            <row>2 1 2 0 1 2 1 2</row>
            <row>1 0 1 2 1 0 2 1</row>
            <row>0 2 1 0 2 1 0 2</row>
            <row>2 1 0 1 2 0 1 2</row>
            <row>1 0 2 1 0 2 1 0</row>
            <row>2 1 2 0 1 2 0 1</row>
            <row>0 2 1 2 1 0 2 1</row>
        </cells>
    </grid>
    <parameters>
        <threshold>0.7</threshold>
        <states>
            <state id="0" color="#FFFFFF"/>
            <state id="1" color="#3498DB"/>
            <state id="2" color="#E74C3C"/>
        </states>
    </parameters>
</simulation>
